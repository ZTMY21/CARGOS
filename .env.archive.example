# BACKEND ONLY. Configure via Vercel secret manager, never VITE_* or Git values.
KARDEX_DRIVE_ENABLED=false
KARDEX_DRIVE_AUTHORIZATION_REF=
KARDEX_DRIVE_RELEASE_APPROVED=false
KARDEX_DRIVE_BACKUP_OPERATOR_IDS=
KARDEX_DRIVE_SANDBOX_PROJECT_ID=
# Preview on this PR branch only; metadata changes, no business/source writes.
KARDEX_DRIVE_REAL_COPY_PROJECT_ID=
KARDEX_DRIVE_REAL_COPY_APPROVAL_REF=
# Preferred scoped capability: SHA-256 verifier only in private runtime.
KARDEX_DRIVE_METADATA_KEY=
# Optional legacy direct adapter; NOT required when the scoped gateway is used.
# SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_OWNER_EMAIL=
GOOGLE_DRIVE_FOLDER_IDS_JSON=
KARDEX_DRIVE_CONNECT_ENABLED=false
# OAuth callback stores refresh credentials encrypted outside Vercel env.
KARDEX_DRIVE_OAUTH_STORAGE=encrypted-runtime
# Optional legacy alternative, not needed with encrypted-runtime:
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Independent 32-byte base64 keys; preserve backup key for recovery.
KARDEX_DRIVE_SESSION_KEY=
KARDEX_BACKUP_KEY=
